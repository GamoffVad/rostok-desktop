<!-- Стили библиотеки компонентов «Росток» для стандартных элементов WPF.
     Приложение подключает этот словарь целиком (App.xaml); каждый стиль повторяет класс из index.css веб-версии. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Rostok.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Rostok.Controls;component/Themes/Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Рамка фокуса: только при переходе с клавиатуры (Tab), как :focus-visible в веб-версии; после щелчка мышью её нет -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="2" RadiusY="2" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Текст ─────────────────────────────────────────── -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="34" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="H3" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    <Setter Property="Margin" Value="0,22,0,6" />
  </Style>
  <Style x:Key="Subtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="MaxWidth" Value="600" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style x:Key="Caps" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="22" />
  </Style>
  <Style x:Key="FaintText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Num" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
  </Style>

  <!-- ── Кнопки ───────────────────────────────────────── -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Sheet}" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Rectangle x:Name="focus" RadiusX="2" RadiusY="2" Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="-4" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Dash}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
            <Rectangle x:Name="frame" RadiusX="2" RadiusY="2" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" SnapsToDevicePixels="True" />
            <Rectangle x:Name="focus" RadiusX="2" RadiusY="2" Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="-4" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="Stroke" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="Stroke" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="StrokeDashArray" Value="{x:Null}" />
              <Setter Property="Background" Value="{StaticResource Soft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Опасное действие в виде обычной кнопки: «Удалить группу и 12 детей» -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
  </Style>

  <!-- Действие в строке: мелкий текст с пунктирным подчёркиванием -->
  <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <StackPanel VerticalAlignment="Center">
              <ContentPresenter x:Name="content" RecognizesAccessKey="False" />
              <Rectangle x:Name="line" Height="1" Margin="0,1,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True">
                <Rectangle.OpacityMask>
                  <DrawingBrush TileMode="Tile" Viewport="0,0,6,1" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                      <GeometryDrawing Brush="Black" Geometry="M0,0 H3 V1 H0 Z" />
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Rectangle.OpacityMask>
              </Rectangle>
            </StackPanel>
            <Rectangle x:Name="focus" Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="-3,4" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TextActionDanger" TargetType="Button" BasedOn="{StaticResource TextAction}">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>

  <!-- Квадратная кнопка-иконка: пунктирная рамка, при наведении — акцент -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Dash}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Rectangle x:Name="frame" RadiusX="2" RadiusY="2" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" SnapsToDevicePixels="True" />
            <Rectangle x:Name="focus" RadiusX="2" RadiusY="2" Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="-3" Visibility="Collapsed" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="Stroke" Value="{StaticResource Accent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="c:Ui.IsDanger" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{StaticResource Danger}" />
              <Setter TargetName="frame" Property="Stroke" Value="{StaticResource Danger}" />
            </MultiTrigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="Stroke" Value="{StaticResource Accent}" />
              <Setter TargetName="frame" Property="StrokeDashArray" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Строка списка в боковой панели: активная — акцентная черта слева и мягкая подложка -->
  <Style x:Key="TreeRow" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="row" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
              <Rectangle x:Name="bar" Width="2" HorizontalAlignment="Left" Fill="Transparent" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter TargetName="row" Property="Background" Value="{StaticResource Soft}" />
              <Setter TargetName="bar" Property="Fill" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вкладки: подчёркнутая активная вкладка (.subtabs) и вкладки разделов со счётчиком (.type-tabs) -->
  <Style x:Key="SubTab" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
            <Rectangle x:Name="line" Height="2" VerticalAlignment="Bottom" Fill="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter TargetName="line" Property="Fill" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TypeTab" TargetType="Button" BasedOn="{StaticResource SubTab}">
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- Верхнее меню: те же вкладки -->
  <Style x:Key="NavTab" TargetType="Button" BasedOn="{StaticResource SubTab}" />

  <!-- Отметка балла: 0–3 или этап звука; нажатая окрашивается цветом уровня -->
  <Style x:Key="Mark" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="Background" Value="{StaticResource Sheet}" />
    <Setter Property="BorderBrush" Value="{StaticResource Dash}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="2">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
              <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="c:Ui.IsActive" Value="True" /><Condition Property="c:Ui.Level" Value="0" /></MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#2C6B45" /><Setter Property="Background" Value="#DDE9DF" /><Setter Property="BorderBrush" Value="#2C6B45" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="c:Ui.IsActive" Value="True" /><Condition Property="c:Ui.Level" Value="1" /></MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#746410" /><Setter Property="Background" Value="#EFE8CF" /><Setter Property="BorderBrush" Value="#746410" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="c:Ui.IsActive" Value="True" /><Condition Property="c:Ui.Level" Value="2" /></MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#9A5413" /><Setter Property="Background" Value="#F3E0CC" /><Setter Property="BorderBrush" Value="#9A5413" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="c:Ui.IsActive" Value="True" /><Condition Property="c:Ui.Level" Value="3" /></MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#A32D22" /><Setter Property="Background" Value="#F3DEDB" /><Setter Property="BorderBrush" Value="#A32D22" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="c:Ui.IsActive" Value="True" /><Condition Property="c:Ui.IsAccent" Value="True" /></MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{StaticResource Sheet}" /><Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Широкая отметка с подписью: «правый / левый», «нет / есть», стратегии сканирования -->
  <Style x:Key="MarkWide" TargetType="Button" BasedOn="{StaticResource Mark}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="c:Ui.IsAccent" Value="True" />
  </Style>

  <!-- Имя-ссылка в таблице: чернила, полужирный; при наведении — акцент (.tbl a.name) -->
  <Style x:Key="NameLink" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ContentPresenter RecognizesAccessKey="False" VerticalAlignment="Center" />
            <Rectangle x:Name="focus" Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="-3" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Поля ─────────────────────────────────────────── -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Sheet}" />
    <Setter Property="BorderBrush" Value="{StaticResource Dash}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentLight}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ContextMenu" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
            <Grid Margin="{TemplateBinding Padding}">
              <TextBlock x:Name="hint" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{StaticResource Faint}" Opacity="0.85" Margin="3,0,0,0"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsInvalid" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
            <Trigger Property="AcceptsReturn" Value="True">
              <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Sheet}" />
    <Setter Property="BorderBrush" Value="{StaticResource Dash}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentLight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ContextMenu" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
            <Grid Margin="{TemplateBinding Padding}">
              <TextBlock x:Name="hint" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{StaticResource Faint}" Opacity="0.85" Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.HasText" Value="True">
              <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="c:Ui.IsInvalid" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Danger}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Подсказка вместо системного title ─────────────── -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Ink}" />
    <Setter Property="Foreground" Value="{StaticResource Sheet}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Top" />
    <Setter Property="VerticalOffset" Value="-6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="9,6" MaxWidth="280">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="LineHeight" Value="17" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Полосы прокрутки: тонкие, цвета пунктира ──────── -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" Background="{StaticResource Dash}" CornerRadius="2" Margin="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="{StaticResource Ink3}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="t" Property="Background" Value="{StaticResource Ink3}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

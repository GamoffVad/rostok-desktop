<!-- Дизайн-система «Тёплый мел», схема «Ежевика». Значения совпадают с CSS-переменными веб-версии (index.css). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="PaperColor">#F8F4EB</Color>
  <Color x:Key="SheetColor">#FFFDF8</Color>
  <Color x:Key="InkColor">#2A2230</Color>
  <Color x:Key="Ink2Color">#463E4D</Color>
  <Color x:Key="Ink3Color">#655C6C</Color>
  <Color x:Key="FaintColor">#6B6272</Color>
  <Color x:Key="DashColor">#CFC8BC</Color>
  <Color x:Key="LineColor">#E0DAD0</Color>
  <Color x:Key="AccentColor">#5A2B63</Color>
  <Color x:Key="AccentLightColor">#7A4A89</Color>
  <Color x:Key="AccentHoverColor">#431F4A</Color>
  <Color x:Key="SoftColor">#F0EADF</Color>
  <Color x:Key="Soft2Color">#E9E2D6</Color>
  <Color x:Key="FormColor">#F2EDE3</Color>
  <Color x:Key="AmberColor">#7A5312</Color>
  <Color x:Key="DangerColor">#A32D22</Color>
  <Color x:Key="OkColor">#2C6B45</Color>
  <Color x:Key="SelectionColor">#E4D6E8</Color>

  <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="Sheet" Color="{StaticResource SheetColor}" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
  <SolidColorBrush x:Key="Ink3" Color="{StaticResource Ink3Color}" />
  <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="Dash" Color="{StaticResource DashColor}" />
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}" />
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="Soft" Color="{StaticResource SoftColor}" />
  <SolidColorBrush x:Key="Soft2" Color="{StaticResource Soft2Color}" />
  <SolidColorBrush x:Key="FormBg" Color="{StaticResource FormColor}" />
  <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="Selection" Color="{StaticResource SelectionColor}" />

  <FontFamily x:Key="UiFont">pack://application:,,,/Rostok.Controls;component/Fonts/#Golos Text</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Rostok.Controls;component/Fonts/#IBM Plex Mono</FontFamily>
  <sys:Double x:Key="TapMin">34</sys:Double>
</ResourceDictionary>
